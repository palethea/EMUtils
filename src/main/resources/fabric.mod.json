{
	"schemaVersion": 1,
	"id": "emutils",
	"version": "${version}",
	"name": "EMUtils",
	"description": "A lightweight client-side utilities mod for Minecraft 1.21.11 on Fabric.",
	"authors": [
		"mwsk75996"
	],
	"contact": {
		"homepage": "https://github.com/palethea/EMUtils",
		"sources": "https://github.com/palethea/EMUtils"
	},
	"license": "Apache-2.0",
	"icon": "assets/emutils/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.emutils.client.EMUtilsClient"
		],
		"modmenu": [
			"net.emutils.client.modmenu.EMUtilsModMenu"
		]
	},
	"mixins": [
		"emutils.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"iris": "*",
		"minescript": "*"
	}
}
